  "preprocess_settings": {
    "enable_preprocess": true,
    "steps": {
      "remove_sidebar": {
        "enabled": true,
        "selector": ".main-preview-aside",
        "wait_after": 2000
      },
      "adjust_zoom": {
        "enabled": true,
        "zoom_out_target": 10,
        "zoom_in_target": 180,
        "click_delay": 500,
        "wait_after_target": 2000
      },
      "remove_toolbar": {
        "enabled": true,
        "selector": ".sharepreview-toolkit",
        "wait_after": 2000
      }
    }
  },
  "browser_settings": {
    "headless": true,
    "viewport_timeout": 1000,
    "page_load_timeout": 5000,
    "preprocess_timeout": 2000
  },
  "crop_settings": {
    "enabled": true,
    "crop_margins": {
      "top": 45,
      "right": 40,
      "bottom": 183,
      "left": 55
    },
    "crop_units": "px",
    "description": "裁剪PDF页面边距，单位：像素。top: 上边距, right: 右边距, bottom: 下边距, left: 左边距"
  },
  "output_settings": {
    "output_dir": "/Users/leiyang/Desktop/new/pdf",
    "filename_template": "{title}.pdf",
    "timestamp_format": "%Y%m%d_%H%M%S"
  },
  "debug_settings": {
    "verbose_logging": true,
    "show_browser_window": true,
    "save_screenshots": false,
    "screenshot_dir": "./screenshots"
  }
}